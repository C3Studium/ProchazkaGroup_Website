{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "sync:styles": "node scripts/sync-styles.js",
    "watch:styles": "chokidar \"src\" -i \"src/styles/system/**\" -i \"src/styles/globals.scss\" -i \"src/styles/_generated-styles.scss\" -i \"**/node_modules/**\" -i \"**/.next/**\" -c \"node scripts/sync-styles.js --event {event} --path '{path}'\"",
    "dev": "pnpm run sync:styles && concurrently \"pnpm run watch:styles\" \"node scripts/run-next-with-storefront-env.js dev -p 3690\"",
    "build": "pnpm run sync:styles && node scripts/run-next-with-storefront-env.js build",
    "start": "node scripts/run-next-with-storefront-env.js start --hostname 0.0.0.0",
    "build:next": "node scripts/run-next-with-storefront-env.js build",
    "lint": "next lint",
    "analyze": "ANALYZE=true next build",
    "postbuild": "next-sitemap",
    "dev:email": "email dev --dir ./src/modules/resend/emails --port 3002"
  },
  "dependencies": {
    "@babel/core": "^7.28.5",
    "@babel/eslint-parser": "^7.28.5",
    "@emailjs/browser": "^4.4.1",
    "@next/bundle-analyzer": "^15.5.9",
    "@react-email/components": "^0.5.7",
    "@react-email/preview": "^0.0.13",
    "@react-email/render": "^1.4.0",
    "@react-three/fiber": "^9.7.0",
    "@remixicon/react": "^4.8.0",
    "@supabase/supabase-js": "^2.90.0",
    "@types/js-cookie": "^3.0.6",
    "@vercel/analytics": "^1.6.1",
    "axios": "^1.13.2",
    "babel-loader": "^10.0.0",
    "babel-plugin-react-compiler": "19.1.0-rc.3",
    "flubber": "^0.4.2",
    "framer-motion": "^12.24.11",
    "glob": "^13.0.0",
    "gsap": "^3.15.0",
    "js-cookie": "^3.0.5",
    "lenis": "^1.3.17",
    "lodash": "^4.17.21",
    "lodash.throttle": "^4.1.1",
    "next": "^16.1.1",
    "next-sitemap": "^4.2.3",
    "npm": "^11.7.0",
    "ogl": "^1.0.11",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-flag-icons": "^1.0.6",
    "react-icons": "^5.5.0",
    "recharts": "^3.6.0",
    "regl": "^2.1.1",
    "resend": "^6.7.0",
    "sass": "^1.97.2",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@react-email/preview-server": "4.3.2",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.5.9",
    "react-email": "^4.3.2"
  }
}
